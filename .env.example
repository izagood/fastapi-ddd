# SQLite (기본값, 즉시 사용 가능)
DATABASE_URL=sqlite+aiosqlite:///fastapi_ddd.db

# PostgreSQL (운영 환경)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_ddd

# SQL 쿼리 로깅 (기본값: false)
SQL_ECHO=false

# 테이블 자동 생성 (운영에서는 false로 설정, Alembic 사용)
AUTO_CREATE_TABLES=true

# CORS 설정 (쉼표 구분, "*"은 전체 허용)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
